{
  "theme": "dark",
  "colors": {
    "background": "#06090B",
    "surface": "#0B1013",
    "raised": "#10171B",
    "line": "rgba(255, 255, 255, 0.08)",
    "lineStrong": "rgba(255, 255, 255, 0.16)",
    "text": "#F3F6F5",
    "textMuted": "#9AA7A3",
    "textFaint": "#66726E",
    "accent": "#3DDC97",
    "accentHover": "#5FE8AD",
    "accentTint": "rgba(61, 220, 151, 0.12)",
    "danger": "#FF6B6B"
  },
  "typography": {
    "fonts": {
      "sans": "Geist, Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'Geist Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "scale": {
      "h1": {
        "size": "clamp(40px, 6vw, 76px)",
        "weight": 600,
        "lineHeight": 1.05,
        "letterSpacing": "-0.03em"
      },
      "h2": {
        "size": "clamp(30px, 4vw, 52px)",
        "weight": 600,
        "lineHeight": 1.1,
        "letterSpacing": "-0.025em"
      },
      "h3": {
        "size": "22px",
        "weight": 600,
        "lineHeight": 1.25,
        "letterSpacing": "-0.015em"
      },
      "bodyLanding": {
        "size": "17px",
        "weight": 400,
        "lineHeight": 1.65
      },
      "bodyArticle": {
        "size": "16px",
        "weight": 400,
        "lineHeight": 1.7
      },
      "small": {
        "size": "14px",
        "weight": 400,
        "lineHeight": 1.5
      },
      "label": {
        "size": "12px",
        "weight": 500,
        "lineHeight": 1.4,
        "letterSpacing": "0.04em"
      }
    }
  },
  "spacing": {
    "base": 8,
    "container": "1160px",
    "articleMax": "740px",
    "sectionDesktop": "128px",
    "sectionMobile": "80px"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "20px"
  },
  "shadows": {
    "soft": "0 20px 48px -12px rgba(0, 0, 0, 0.75)"
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "durationScene": "400ms to 900ms",
    "durationText": "300ms",
    "staggerText": "60ms",
    "textRise": "12px"
  }
}

