# ===================================================
# RMS Face AI — Environment Variables
# ===================================================
# Copy this file to .env and fill in your values.
# The backend reads these via python-dotenv on startup.
# ===================================================

# ── Database (Supabase PostgreSQL) ──────────────────
# Get your connection string from Supabase → Settings → Database → Connection string (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/rms_faceai

# ── Authentication ──────────────────────────────────
# Secret key for Flask session and general cryptographic operations
SECRET_KEY=change-me-to-a-random-64-char-string

# Secret key specifically for signing JWT access/refresh tokens
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string

# JWT token lifetimes
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# ── Deployment Mode ─────────────────────────────────
# If DATABASE_URL is NOT set, the system falls back to single-tenant
# local file-based mode (original behavior). This is the on-prem
# appliance mode described in the SaaS blueprint.

# Set to "true" to lazy-load ML models on first request instead of startup
# LAZY_LOAD_MODELS=true

# Frontend URL for CORS (required in production)
# FRONTEND_URL=https://your-app.vercel.app

# Storage directory override (for Docker volume mounts)
# STORAGE_DIR=/data/rms
