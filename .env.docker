# ===================================================
# RMS Face AI — Docker Compose Environment Template
# ===================================================
# Copy this file to .env before running:
#   docker compose up --build -d
# ===================================================

# ── PostgreSQL Database Credentials ─────────────────
POSTGRES_USER=rms
POSTGRES_PASSWORD=rms_prod_secure_password_2026
POSTGRES_DB=rms_db
DATABASE_URL=postgresql://rms:rms_prod_secure_password_2026@postgres:5432/rms_db

# ── Redis & Celery Background Queue ─────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Cryptography & JWT Security Keys ────────────────
# In production, generate 64-char random strings using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=9f8e7d6c5b4a3928170e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c
JWT_SECRET_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=14

# ── System Operational Mode ─────────────────────────
# 'cloud' for multi-tenant PostgreSQL mode with org isolation
# 'local' for single-tenant air-gapped appliance mode
DEPLOYMENT_MODE=cloud

# ── Web Frontend URL for CORS Security ──────────────
# Change to your public domain when live (e.g., https://rms.yourdomain.com)
FRONTEND_URL=http://localhost

# ── Offline Appliance License Signing Key ───────────
LICENSE_VERIFICATION_KEY=rms-super-secret-license-key-for-offline
