{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://13-60-225-165.sslip.io/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://13-60-225-165.sslip.io/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(sw.js|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
